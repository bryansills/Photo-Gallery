{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'group:monorepos',
    'group:recommended',
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  labels: [
    'renovate',
  ],
  semanticCommits: 'disabled',
  customManagers: [
    // Update .java-version file with the latest JDK version.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.java-version$/',
      ],
      matchStrings: [
        '(?<currentValue>.*)\\n',
      ],
      datasourceTemplate: 'java-version',
      depNameTemplate: 'java',
      // Only write the major version.
      extractVersionTemplate: '^(?<version>\\d+)',
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
      ],
      // Default to 7 day dependency cooldowns.
      minimumReleaseAge: '7 days',
      "automerge": false
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch'
      ],
      // Default to 7 day dependency cooldowns.
      minimumReleaseAge: '7 days',
      "description": "Auto-merge most dependency updates.",
      // Ignore the cooldown for libraries that have not reached 1.x status yet.
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchPackagePatterns": [
        "org.jetbrains.kotlin.*",
        "org.jetbrains.kotlin:*"
      ],
      "groupName": "Kotlin",
    },
    {
      "matchPackagePatterns": [
        "dev.zacsweers.metro*"
      ],
      "groupName": "Metro",
    },
    {
      "matchPackagePatterns": [
        "com.android.application",
        "com.android.library",
        "com.android.lint",
        "com.android.kotlin.multiplatform.library",
        "com.android.kotlin.multiplatform.library",
        "com.android.tools.build*"
      ],
      "groupName": "Android Gradle plugins",
    }
  ]
}
